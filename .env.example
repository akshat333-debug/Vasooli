# ---------------------------------------------------------------------------
# LLM gateway (any OpenAI-compatible endpoint)
# ---------------------------------------------------------------------------
# The engine runs WITHOUT this. `vasooli run --no-llm` and every experiment are
# dictionary-only, and a missing or unreachable model degrades to human review
# rather than crashing (see diagnose.py). Set it only to exercise the AI stage.
#
# Use a PRICED model id. RunFuse's max_cost_usd guardrail can only bound spend
# it can price, and pointing it at an unpriced local model made that limit
# silently inert -- logged as defect 1. A public endpoint with a known-price
# model is what makes the guardrail real.
VASOOLI_LLM_BASE_URL=https://api.openai.com/v1
VASOOLI_LLM_API_KEY=
VASOOLI_LLM_MODEL=gpt-4o-mini

# Local gateway used during development. Unpriced, so max_cost_usd is inert
# against it -- fine for iteration, not for demonstrating the guardrail.
# VASOOLI_LLM_BASE_URL=http://localhost:20128/v1
# VASOOLI_LLM_MODEL=kr/claude-haiku-4.5

# ---------------------------------------------------------------------------
# Razorpay TEST MODE ONLY. Never put live keys here.
# ---------------------------------------------------------------------------
# razorpay_adapter._auth() refuses any key not prefixed rzp_test_. Optional:
# without them the live probe reports "no credentials" and the batch runs on.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---------------------------------------------------------------------------
# Audit ledger
# ---------------------------------------------------------------------------
# Unset, the hash chain is unkeyed: it detects accidental edits, but anyone
# with write access to the database can rebuild it and it will verify clean.
# Set this and forging the chain needs the key as well as write access.
VASOOLI_LEDGER_KEY=
